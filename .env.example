# Chave da API DeepL. Terminada em ":fx" = plano Free. Nunca versionar o .env.
DEEPL_API_KEY=

# Endereço e porta da API local. O padrão 127.0.0.1 só atende este computador;
# para publicar na rede, use HOST=0.0.0.0 (e aí autenticação e HTTPS viram obrigatórios).
# HOST=127.0.0.1
# PORT=3000

# Limites de entrada (padrões folgados para coleções de 1.000 a 2.000 peças).
# MAX_CORPO_BYTES=1000000
# MAX_DESCRICOES_LOTE=10000
# MAX_CARACTERES_DESCRICAO=200

# Chamadas à DeepL: 1 descrição por chamada por padrão (o `context` perde força em lotes
# maiores: 87% de obediência ao glossário com 1, 68% com 50; a API aceita até 50, útil
# quando o glossário nativo existir), 3 chamadas ao mesmo tempo para o servidor inteiro
# (o plano Free responde 429 com mais), 3 tentativas com espera de 1 s, 2 s... para
# falhas passageiras, 15 s de espera máxima por chamada.
# DEEPL_TAMANHO_LOTE=1
# DEEPL_CHAMADAS_SIMULTANEAS=3
# DEEPL_TENTATIVAS=3
# DEEPL_ESPERA_RETRY_MS=1000
# DEEPL_TIMEOUT_MS=15000
# Disjuntor: após N tentativas falhas seguidas (rede, timeout, 429, 5xx), a DeepL fica
# suspensa por este tempo e os lotes usam o motor local na hora, sem repetir as esperas.
# DEEPL_FALHAS_SEGUIDAS=9
# DEEPL_CIRCUITO_ABERTO_MS=30000
# 429 ("muitas requisições") é a DeepL pedindo calma, não queda: o servidor inteiro pausa
# (2 s, dobrando até 30 s, ou o Retry-After dela) e repete; só depois de 2 minutos sem
# nenhum sucesso o restante vai para o motor local.
# DEEPL_PAUSA_429_MS=2000
# DEEPL_PAUSA_MAXIMA_429_MS=30000
# DEEPL_PACIENCIA_429_MS=120000

# Na rede da empresa (inspeção TLS), inicie com `npm start`: ele passa
# --use-system-ca ao Node para confiar nos certificados instalados no Windows.
